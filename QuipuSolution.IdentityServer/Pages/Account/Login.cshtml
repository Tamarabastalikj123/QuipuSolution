@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<h1>Sign in</h1>

<form method="post">
    <input type="hidden" asp-for="Input.ReturnUrl" />

    <label asp-for="Input.Username">Username</label>
    <input asp-for="Input.Username" type="text" autofocus autocomplete="username" />

    <label asp-for="Input.Password">Password</label>
    <input asp-for="Input.Password" type="password" autocomplete="current-password" />

    <button type="submit">Sign in</button>

    @if (Model.ErrorMessage is not null)
    {
        <div class="error">@Model.ErrorMessage</div>
    }
</form>

@if (Model.ShowTestUsers)
{
    <div class="hint">Test users: <b>alice</b> / alice, <b>bob</b> / bob</div>
}
